<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns="http://www.owl-ontologies.com/Ontology1499950212.owl#"
    xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#"
    xmlns:xsp="http://www.owl-ontologies.com/2005/08/07/xsp.owl#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:swrl="http://www.w3.org/2003/11/swrl#"
    xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xml:base="http://www.owl-ontologies.com/Ontology1499950212.owl">
  <owl:Ontology rdf:about="">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      Author: Anne Merel Sternheim&#xD;
    &lt;/p&gt;</rdfs:comment>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >This ontology is still very basic, but proofs the concept: measured emotions can be put into predefined classes, which together with an agent's moods determine the emotional state, which causes the system to respond in a certain way. Ranges are to be added later, as well as more different labels. WORK IN PROGRESS. (read internship report for more background information)</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:ID="BResponse">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Response"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:ID="ResponseIs"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >I'm sad to hear that you're not feeling positive now. But don't worry too much about it, because it will get better!</owl:hasValue>
      </owl:Restriction>
    </rdfs:subClassOf>
    <owl:disjointWith>
      <owl:Class rdf:ID="CResponse"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:ID="DResponse"/>
    </owl:disjointWith>
    <owl:disjointWith>
      <owl:Class rdf:ID="AResponse"/>
    </owl:disjointWith>
  </owl:Class>
  <owl:Class rdf:ID="NegativeIntensity">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Intensity"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="Afraid">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:ID="Emotion"/>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:ID="hasIntensityValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >165</owl:hasValue>
                  </owl:Restriction>
                  <owl:Restriction>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >-148</owl:hasValue>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:ID="hasValenceValue"/>
                    </owl:onProperty>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
              <owl:Restriction>
                <owl:onProperty>
                  <owl:DatatypeProperty rdf:ID="hasLabel"/>
                </owl:onProperty>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >Afraid</owl:hasValue>
              </owl:Restriction>
            </owl:unionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="PositiveIntensity"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:ID="NegativeValence"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >165</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >-148</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >Afraid</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasLabel"/>
            </owl:onProperty>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#Response">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      The output specifies the action that is to be taken, based on the &#xD;
      emotional state of the agent. In this case, four sentences were &#xD;
      constructed that regard the agent's emotional state.&#xD;
    &lt;/p&gt;</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="causedByEmotionalState"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="C">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:ID="EmotionalState"/>
          <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
              <owl:Restriction>
                <owl:someValuesFrom>
                  <owl:Class rdf:ID="PositiveValence"/>
                </owl:someValuesFrom>
                <owl:onProperty>
                  <owl:ObjectProperty rdf:ID="containsEmotion"/>
                </owl:onProperty>
              </owl:Restriction>
              <owl:Restriction>
                <owl:onProperty>
                  <owl:ObjectProperty rdf:ID="containsMood"/>
                </owl:onProperty>
                <owl:someValuesFrom>
                  <owl:Class rdf:ID="BadMood"/>
                </owl:someValuesFrom>
              </owl:Restriction>
            </owl:intersectionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      When an agent has a negatively valenced mood, but a positively valenced &#xD;
      emotion, the emotion has the potency to lift up the mood.&#xD;
    &lt;/p&gt;</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:someValuesFrom>
          <owl:Class rdf:about="#CResponse"/>
        </owl:someValuesFrom>
        <owl:onProperty>
          <owl:ObjectProperty rdf:ID="causesResponse"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#EmotionalState">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:someValuesFrom rdf:resource="#Response"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#causesResponse"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#containsEmotion"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#containsMood"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      An emotional state is the result of the continuous influence that mood &#xD;
      and emotion have on each other, observed at a certain point in time in a &#xD;
      single individual (agent).&#xD;
    &lt;/p&gt;&#xD;
    &lt;p style="margin-top: 0"&gt;&#xD;
      As a proof of concept, four types of emotional state have been specified. Other emotional states could be added, like for example a confused state in which the agent has two different(ly valenced) emotions at the same time. (For these purposes the restrictions will need to be changed as well)
    &lt;/p&gt;</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#PositiveIntensity">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      &#xD;I would really like to be able to use ranges of integers to define these classes, but I can't because of protege 3.5... So I will put all labels into the classes manually
    &lt;/p&gt;</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#Intensity"/>
  </owl:Class>
  <owl:Class rdf:ID="Valence"/>
  <owl:Class rdf:ID="Tense">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Restriction>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >121</owl:hasValue>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
                    </owl:onProperty>
                  </owl:Restriction>
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >-206</owl:hasValue>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
              <owl:Restriction>
                <owl:onProperty>
                  <owl:DatatypeProperty rdf:about="#hasLabel"/>
                </owl:onProperty>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >Tense</owl:hasValue>
              </owl:Restriction>
            </owl:unionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >121</owl:hasValue>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >-206</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasLabel"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >Tense</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#PositiveIntensity"/>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#NegativeValence"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="Satisfied">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >-15</owl:hasValue>
                  </owl:Restriction>
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >182</owl:hasValue>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
              <owl:Restriction>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >Satisfied</owl:hasValue>
                <owl:onProperty>
                  <owl:DatatypeProperty rdf:about="#hasLabel"/>
                </owl:onProperty>
              </owl:Restriction>
            </owl:unionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >-15</owl:hasValue>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >182</owl:hasValue>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasLabel"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >Satisfied</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#NegativeIntensity"/>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#PositiveValence"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="Happy">
    <rdfs:subClassOf rdf:resource="#PositiveIntensity"/>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#PositiveValence"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >62</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >179</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasLabel"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >Happy</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Restriction>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >62</owl:hasValue>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
                    </owl:onProperty>
                  </owl:Restriction>
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >179</owl:hasValue>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
              <owl:Restriction>
                <owl:onProperty>
                  <owl:DatatypeProperty rdf:about="#hasLabel"/>
                </owl:onProperty>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >Happy</owl:hasValue>
              </owl:Restriction>
            </owl:unionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="Calm">
    <rdfs:subClassOf rdf:resource="#NegativeIntensity"/>
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >-80</owl:hasValue>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >172</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >Calm</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasLabel"/>
            </owl:onProperty>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="#PositiveValence"/>
    </rdfs:subClassOf>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >-80</owl:hasValue>
                  </owl:Restriction>
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >172</owl:hasValue>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
              <owl:Restriction>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >Calm</owl:hasValue>
                <owl:onProperty>
                  <owl:DatatypeProperty rdf:about="#hasLabel"/>
                </owl:onProperty>
              </owl:Restriction>
            </owl:unionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="Angry">
    <rdfs:subClassOf>
      <owl:Class rdf:about="#NegativeValence"/>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#PositiveIntensity"/>
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >118</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >-134</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasLabel"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >Angry</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >118</owl:hasValue>
                  </owl:Restriction>
                  <owl:Restriction>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >-134</owl:hasValue>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
                    </owl:onProperty>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
              <owl:Restriction>
                <owl:onProperty>
                  <owl:DatatypeProperty rdf:about="#hasLabel"/>
                </owl:onProperty>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >Angry</owl:hasValue>
              </owl:Restriction>
            </owl:unionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="Aroused">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Restriction>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >201</owl:hasValue>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
                    </owl:onProperty>
                  </owl:Restriction>
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >-9</owl:hasValue>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
              <owl:Restriction>
                <owl:onProperty>
                  <owl:DatatypeProperty rdf:about="#hasLabel"/>
                </owl:onProperty>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >Aroused</owl:hasValue>
              </owl:Restriction>
