  <owl:Class rdf:ID="A">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      When both emotion and mood are of low valence, the agent's emotional state will &#xD;
      get increasingly better, or at least keep itself at a positive valence&#xD;
    &lt;/p&gt;</rdfs:comment>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#EmotionalState"/>
          <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
              <owl:Restriction>
                <owl:someValuesFrom rdf:resource="#PositiveValence"/>
                <owl:onProperty>
                  <owl:ObjectProperty rdf:about="#containsEmotion"/>
                </owl:onProperty>
              </owl:Restriction>
              <owl:Restriction>
                <owl:someValuesFrom rdf:resource="#GoodMood"/>
                <owl:onProperty>
                  <owl:ObjectProperty rdf:about="#containsMood"/>
                </owl:onProperty>
              </owl:Restriction>
            </owl:intersectionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:someValuesFrom rdf:resource="#AResponse"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#causesResponse"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#Mood">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasLabel"/>
        </owl:onProperty>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
        </owl:onProperty>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      Moods generally have no specific labels. Sometimes 'happy' is regarded &#xD;
      as a mood, while 'joy' reflects its emotional counterpart, but research &#xD;
      on this topic is only few, and inconsistent.&#xD;
    &lt;/p&gt;&#xD;
    &lt;p style="margin-top: 0"&gt;&#xD;
      For these reasons, only 'bad' (negative valence) and 'good' (positive &#xD;
      valence) moods are defined in this ontology. Moods always have negative &#xD;
      (low) intensity.&#xD;
    &lt;/p&gt;</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="#Emotion">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      Emotions have different labels in different languages. A direct &#xD;
      translation of an emotion word can also have a different value for &#xD;
      valence (pleasantness) and intensity (arousal). The English emotion &#xD;
      labels presented here are taken from James Russell's 'A circumplex model &#xD;
      of affect'.&#xD;
    &lt;/p&gt;</rdfs:comment>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Would it make sense to make Emotion a subclass of Arousal and Valence? Or does it make more sense to just keep them apart?</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
        </owl:onProperty>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasLabel"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
        >1</owl:cardinality>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="Astonished">
    <rdfs:subClassOf rdf:resource="#PositiveValence"/>
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >211</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >50</owl:hasValue>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >Astonished</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasLabel"/>
            </owl:onProperty>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#PositiveIntensity"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Restriction>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >211</owl:hasValue>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
                    </owl:onProperty>
                  </owl:Restriction>
                  <owl:Restriction>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >50</owl:hasValue>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
                    </owl:onProperty>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
              <owl:Restriction>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >Astonished</owl:hasValue>
                <owl:onProperty>
                  <owl:DatatypeProperty rdf:about="#hasLabel"/>
                </owl:onProperty>
              </owl:Restriction>
            </owl:unionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="Distressed">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >101</owl:hasValue>
                  </owl:Restriction>
                  <owl:Restriction>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >-204</owl:hasValue>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
                    </owl:onProperty>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
              <owl:Restriction>
                <owl:onProperty>
                  <owl:DatatypeProperty rdf:about="#hasLabel"/>
                </owl:onProperty>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >Distressed</owl:hasValue>
              </owl:Restriction>
            </owl:unionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >101</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >-204</owl:hasValue>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >Distressed</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasLabel"/>
            </owl:onProperty>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#PositiveIntensity"/>
    <rdfs:subClassOf rdf:resource="#NegativeValence"/>
  </owl:Class>
  <owl:Class rdf:about="#CResponse">
    <rdfs:subClassOf rdf:resource="#Response"/>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >Yes! Keep up those positive vibes now! They will make you feel better on the long term.</owl:hasValue>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#ResponseIs"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <owl:disjointWith rdf:resource="#BResponse"/>
    <owl:disjointWith rdf:resource="#DResponse"/>
    <owl:disjointWith rdf:resource="#AResponse"/>
  </owl:Class>
  <owl:Class>
    <owl:unionOf rdf:parseType="Collection">
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >211</owl:hasValue>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >50</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
            </owl:onProperty>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#hasLabel"/>
        </owl:onProperty>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >Astonished</owl:hasValue>
      </owl:Restriction>
    </owl:unionOf>
  </owl:Class>
  <owl:Class rdf:ID="Gloomy">
    <rdfs:subClassOf rdf:resource="#NegativeValence"/>
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >-129</owl:hasValue>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >-182</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasLabel"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >Gloomy</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#NegativeIntensity"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Restriction>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >-129</owl:hasValue>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
                    </owl:onProperty>
                  </owl:Restriction>
                  <owl:Restriction>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >-182</owl:hasValue>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
                    </owl:onProperty>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
              <owl:Restriction>
                <owl:onProperty>
                  <owl:DatatypeProperty rdf:about="#hasLabel"/>
                </owl:onProperty>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >Gloomy</owl:hasValue>
              </owl:Restriction>
            </owl:unionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="Pleased">
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >46</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >205</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasLabel"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >Pleased</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#PositiveIntensity"/>
    <rdfs:subClassOf rdf:resource="#PositiveValence"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Restriction>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >46</owl:hasValue>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
                    </owl:onProperty>
                  </owl:Restriction>
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >205</owl:hasValue>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
              <owl:Restriction>
                <owl:onProperty>
                  <owl:DatatypeProperty rdf:about="#hasLabel"/>
                </owl:onProperty>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >Pleased</owl:hasValue>
              </owl:Restriction>
            </owl:unionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="Annoyed">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >86</owl:hasValue>
                  </owl:Restriction>
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >-185</owl:hasValue>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
              <owl:Restriction>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >Annoyed</owl:hasValue>
                <owl:onProperty>
                  <owl:DatatypeProperty rdf:about="#hasLabel"/>
                </owl:onProperty>
              </owl:Restriction>
            </owl:unionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >86</owl:hasValue>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >-185</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasLabel"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >Annoyed</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="#PositiveIntensity"/>
    <rdfs:subClassOf rdf:resource="#NegativeValence"/>
  </owl:Class>
  <owl:Class rdf:ID="Agent">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      An agent can be animate or inanimate, as long as it can have an &#xD;
      emotional state&#xD;
    &lt;/p&gt;</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:ID="D">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#EmotionalState"/>
          <owl:Class>
            <owl:intersectionOf rdf:parseType="Collection">
              <owl:Restriction>
                <owl:onProperty>
                  <owl:ObjectProperty rdf:about="#containsEmotion"/>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="#NegativeValence"/>
              </owl:Restriction>
              <owl:Restriction>
                <owl:someValuesFrom>
                  <owl:Class rdf:about="#BadMood"/>
                </owl:someValuesFrom>
                <owl:onProperty>
                  <owl:ObjectProperty rdf:about="#containsMood"/>
                </owl:onProperty>
              </owl:Restriction>
            </owl:intersectionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      When both emotion and mood are of low valence, the agent's emotional &#xD;
      state will get increasingly worse, or at least keep itself at a negatuve&#xD;
      valence.&#xD;
    &lt;/p&gt;</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:someValuesFrom rdf:resource="#DResponse"/>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="#causesResponse"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="#BadMood">
    <rdfs:subClassOf>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >-112</owl:hasValue>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >-112</owl:hasValue>
          </owl:Restriction>
          <owl:Restriction>
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="#hasLabel"/>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >Bad Mood</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Mood"/>
          <owl:Class>
            <owl:unionOf rdf:parseType="Collection">
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Restriction>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasIntensityValue"/>
                    </owl:onProperty>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >-112</owl:hasValue>
                  </owl:Restriction>
                  <owl:Restriction>
                    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >-112</owl:hasValue>
                    <owl:onProperty>
                      <owl:DatatypeProperty rdf:about="#hasValenceValue"/>
                    </owl:onProperty>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
              <owl:Restriction>
                <owl:onProperty>
                  <owl:DatatypeProperty rdf:about="#hasLabel"/>
                </owl:onProperty>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >Bad Mood</owl:hasValue>
              </owl:Restriction>
            </owl:unionOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:ObjectProperty rdf:about="#containsEmotion">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      An emotional state contains a mood and an emotion&#xD;
    &lt;/p&gt;</rdfs:comment>
    <rdfs:range rdf:resource="#Emotion"/>
    <rdfs:domain rdf:resource="#EmotionalState"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:ID="hasEmotionalState">
    <rdfs:domain rdf:resource="#Agent"/>
    <rdfs:range rdf:resource="#EmotionalState"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      An agent has an emotional state&#xD;
    &lt;/p&gt;</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#causesResponse">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      An emotional state leads to an output&#xD;
    &lt;/p&gt;</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="#causedByEmotionalState"/>
    </owl:inverseOf>
    <rdfs:domain rdf:resource="#EmotionalState"/>
    <rdfs:range rdf:resource="#Response"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#containsMood">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      An emotional state contains a mood and an emotion&#xD;
    &lt;/p&gt;</rdfs:comment>
    <rdfs:domain rdf:resource="#EmotionalState"/>
    <rdfs:range rdf:resource="#Mood"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="#causedByEmotionalState">
    <rdfs:domain rdf:resource="#Response"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      An output is caused by an emotional state&#xD;
    &lt;/p&gt;</rdfs:comment>
    <owl:inverseOf rdf:resource="#causesResponse"/>
    <rdfs:range rdf:resource="#EmotionalState"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="#hasValenceValue">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class rdf:about="#Mood"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      Valence values for emotion and mood are in points (pts) relative to the &#xD;
      vertical axis of the graph. Measured manually in Paint, from a &#xD;
      screenshot of Figure 3 in James Russell's 'a circumplex model of affect' &#xD;
      (1980).&#xD;
    &lt;/p&gt;</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#hasLabel">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      Labels for emotion are taken from James Russell's 'a circumplex model of &#xD;
      affect' (1980).&#xD;
    &lt;/p&gt;</rdfs:comment>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class rdf:about="#Mood"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#hasIntensityValue">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      Intensity values for emotion and mood are in points (pts) relative to &#xD;
      the horizontal axis of the graph. Measured manually in Paint, from a screenshot &#xD;
      of Figure 3 in James Russell's 'a circumplex model of affect' (1980).&#xD;
    &lt;/p&gt;</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:domain>
      <owl:Class>
        <owl:unionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Emotion"/>
          <owl:Class rdf:about="#Mood"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#ResponseIs">
    <rdfs:domain rdf:resource="#Response"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      The written or spoken output options that can be the response of the system to the &#xD;
      agent's emotional state&#xD;
    &lt;/p&gt;</rdfs:comment>
    <rdfs:range>
      <owl:DataRange>
        <owl:oneOf rdf:parseType="Resource">
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
          >Yes! Keep up those positive vibes now! They will make you feel better on the long term.</rdf:first>
          <rdf:rest rdf:parseType="Resource">
            <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >Seeing you happy all the time makes me really happy as well!</rdf:first>
            <rdf:rest rdf:parseType="Resource">
              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
              >You don't seem to be feeling well lately. Are you talking to someone about it?</rdf:first>
              <rdf:rest rdf:parseType="Resource">
                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
                >I'm sad to hear that you're not feeling positive now. But don't worry too much about it, because it will get better!</rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
              </rdf:rest>
            </rdf:rest>
          </rdf:rest>
        </owl:oneOf>
      </owl:DataRange>
    </rdfs:range>
  </owl:DatatypeProperty>
  <Mood rdf:ID="Mood_b">
    <hasLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Bad Mood</hasLabel>
  </Mood>
  <Agent rdf:ID="Agent_i">
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      Is any agent&#xD;
    &lt;/p&gt;</rdfs:comment>
    <hasEmotionalState>
      <EmotionalState rdf:ID="EmotionalState_x">
        <causesResponse>
          <Response rdf:ID="Response_q">
            <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >&lt;p style="margin-top: 0"&gt;&#xD;
      Instance of output means there is 'any' output. Kind of output is &#xD;
      determined by the ontology&#xD;
    &lt;/p&gt;</rdfs:comment>
            <causedByEmotionalState rdf:resource="#EmotionalState_x"/>
          </Response>
        </causesResponse>
        <containsMood>
          <Mood rdf:ID="Mood_y">
            <hasValenceValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >112</hasValenceValue>
            <hasIntensityValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >-112</hasIntensityValue>
          </Mood>
        </containsMood>
        <containsEmotion>
          <Emotion rdf:ID="Emotion_a">
            <hasValenceValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >-134</hasValenceValue>
            <hasIntensityValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
            >118</hasIntensityValue>
            <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
            >&lt;p style="margin-top: 0"&gt;&#xD;
      The input for this emotion is the two values of valence and intensity&#xD;
    &lt;/p&gt;</rdfs:comment>
          </Emotion>
        </containsEmotion>
      </EmotionalState>
    </hasEmotionalState>
  </Agent>
  <Emotion rdf:ID="Emotion_z">
    <hasLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Happy</hasLabel>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >&lt;p style="margin-top: 0"&gt;&#xD;
      The input for this emotion is its label&#xD;
    &lt;/p&gt;</rdfs:comment>
  </Emotion>
</rdf:RDF>

