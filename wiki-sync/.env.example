# Copy this file to .env and fill in your credentials.
# .env is gitignored, so your password never gets committed.

XWIKI_BASE_URL=https://xwiki.ewi.tudelft.nl/xwiki
XWIKI_WIKI=sce2026group04
XWIKI_USER=
XWIKI_PASSWORD=

# Comma-separated top-level space names to skip when pulling (system/account pages).
XWIKI_EXCLUDE_SPACES=XWiki
