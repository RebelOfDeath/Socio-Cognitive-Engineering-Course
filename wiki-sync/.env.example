# Copy this file to .env and fill in your credentials.
# .env is gitignored, so your password never gets committed.

XWIKI_BASE_URL=https://xwiki.ewi.tudelft.nl/xwiki
XWIKI_WIKI=sce2026group04
XWIKI_USER=
XWIKI_PASSWORD=

# Comma-separated top-level space names that sync.py skips: XWiki (accounts), and
# tmp: Pitch, which sync_pitch.py keeps in tmp-pitch/.
XWIKI_EXCLUDE_SPACES=XWiki,tmp: Pitch
